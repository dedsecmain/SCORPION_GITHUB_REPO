# SCORPION MK22 starts LOCAL-first. OpenAI is optional.
SCORPION_MODE=LOCAL

# Local AI via Ollama. Leave blank for hardware AUTO selection.
SCORPION_LOCAL_MODEL=
SCORPION_OLLAMA_URL=http://127.0.0.1:11434

# Voice Core
SCORPION_WAKE_WORD=Scorpion
SCORPION_WAKE_LISTENER_ENABLED=false
SCORPION_WAKE_LISTENER_SECONDS=2
SCORPION_WAKE_WAIT_SECONDS=20
SCORPION_COMMAND_END_SILENCE_MS=800
SCORPION_COMMAND_MAX_SECONDS=30
SCORPION_VAD_AGGRESSIVENESS=2
SCORPION_WAKE_WHISPER_MODEL=base
SCORPION_COMMAND_WHISPER_MODEL=auto
SCORPION_WHISPER_MODEL=base
SCORPION_MIC_SECONDS=6

# Natural voice (online Microsoft neural TTS; no OpenAI API credits).
SCORPION_NATURAL_VOICE_ENABLED=true
SCORPION_NATURAL_VOICE=de-DE-KatjaNeural
SCORPION_NATURAL_VOICE_RATE=-4%
SCORPION_NATURAL_VOICE_PITCH=+0Hz

# Optional local storage overrides
# SCORPION_MEMORY_PATH=C:\Users\YOUR_NAME\.scorpion\memory.json
# SCORPION_ADAPTIVE_PATH=C:\Users\YOUR_NAME\.scorpion\adaptive.json

# GitHub Releases update channel. Leave blank until the official repository is configured.
SCORPION_GITHUB_REPO=

# OPTIONAL OpenAI fallback. Every direct request still requires one-time approval.
OPENAI_API_KEY=
SCORPION_MODEL=gpt-5
